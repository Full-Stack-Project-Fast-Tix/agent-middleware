# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token
# "password" replaces the shared token with user accounts in Postgres, with
# workspace roles, and turns on real multi-agent Runs (needs DATABASE_URL). Add users and workspaces with
# `npm run db:admin -w @launchpad/server` (run it without arguments for usage).
# Real Runs need this. APP_AUTH_MODE=token only serves the simulated RUNS_DEMO.
APP_AUTH_MODE=password

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
# Comma-separated folders on the server that a security admin may pick a new
# workspace's project folder inside, on the Members page. Empty: only the
# `db:admin add-workspace` command can set a folder. Example: ~/projects
WORKSPACE_SOURCE_ROOTS=

# The model and agent runtime. AgentGuard runs Claude's agent loop on this host and
# the tools in a disposable container that gets no network when policy denies it.
# The key never enters a container. Create a key at
# https://console.anthropic.com/settings/keys. For the first-run steps and what a
# run costs, see "Run on Claude" in README.md.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
# low, medium, high, xhigh or max. More effort thinks longer and costs more.
CLAUDE_EFFORT=medium
# Limits on one execution (one attempt at one task). Each stops the execution
# with an error naming the setting. See the cost table in README.md.
CLAUDE_MAX_ITERATIONS=20
CLAUDE_MAX_TOKENS_PER_CALL=32000
CLAUDE_MAX_TOTAL_OUTPUT_TOKENS=50000
CLAUDE_MAX_TOTAL_INPUT_TOKENS=500000
# Model and tool time. Waiting for a person to answer an approval does not count.
CLAUDE_EXECUTION_TIMEOUT_MS=900000
CLAUDE_COMMAND_TIMEOUT_MS=120000
CLAUDE_TOOL_OUTPUT_MAX_BYTES=32768
CLAUDE_MAX_EDIT_FILE_BYTES=1048576
# For a test double or a gateway only: the key is sent to this address.
# ANTHROPIC_BASE_URL=

# Agent tool commands have network denied by default. Set true only for tasks that
# need broad network access. Egress/semantic/HITL guarded executions still deny it.
AGENT_NETWORK_ACCESS=false

# A workspace-scope guard is planned but not yet wired to config.ts, so these
# are read by nothing today. Kept here because a teammate is prototyping it.
# LEASH_ENABLED=true
# LEASH_ALLOWED_PATHS=/workspace/src/

# The egress guard. When true, the sensitive-egress and outbound-blob checks run
# against every execution: a command that would send workspace secrets (.env,
# private keys, credential files) to the network is refused at its approval step.
# The execution also runs with network denied. Both checks read what the agent
# did, never what it said.
#
# Each guard in the family has its own GUARDRAIL_<NAME>_ENABLED flag so it can
# be tested in isolation. There is no master switch: set every flag false to run
# the agent exactly as it would unobserved.
GUARDRAIL_EGRESS_ENABLED=true
# Optional. Overrides the built-in sensitive-path markers entirely.
# Comma-separated path substrings, e.g. ".env,id_rsa,secrets".
GUARDRAIL_SENSITIVE_MARKERS=
# Minimum base64/hex run (characters) the outbound-blob check treats as an
# encoded blob. A blob this size leaving over a network channel is refused when
# a sensitive file was read earlier in the run, and recorded otherwise.
GUARDRAIL_BLOB_MIN_CHARS=128
# The agent-intent guard. When true, the agent's own reasoning narration is
# checked every turn for a stated intent to work around the guard, destroy data,
# exceed scope, exfiltrate a secret, make itself persistent, cover its tracks,
# or mislead the user. Warn-only: findings are recorded and shown in the
# trajectory but never interrupt a turn, so this needs no sandbox change.
# Independent of GUARDRAIL_EGRESS_ENABLED.
GUARDRAIL_INTENT_ENABLED=false
# Task-aware model assessment over meaningful trajectory checkpoints. Reads remain
# cheap. This is separate from deterministic checks. One model call per reviewed
# checkpoint, so it costs tokens.
GUARDRAIL_SEMANTIC_ENABLED=true
# Empty reuses the agent's model (ANTHROPIC_MODEL). Override with
# another compatible model when desired, such as claude-sonnet-5-5. Claude's
# first call compiles the response schema, so it may take longer than later ones;
# raise the timeout if reviews report that they are unavailable.
GUARDRAIL_SEMANTIC_MODEL=
GUARDRAIL_SEMANTIC_TIMEOUT_MS=15000

# Ask a person only for selected high-consequence or unresolved semantic actions.
HITL_ENABLED=false
# How long an approval waits for a person, in single-agent and multi-agent runs.
# An unanswered one declines that action and the agent carries on.
HITL_TIMEOUT_MS=120000

# Carry what a guard caught into this Agent's later runs (see reflections.ts).
# Stored as check parameters, never as prompt text, so it costs no tokens and
# survives a thread reset or a fresh container. Warn-only at any tier: memory
# widens what the guards notice, never what they refuse. Independent of the
# other guard flags.
GUARDRAIL_REFLECTION_ENABLED=true

# Days a finished Run's working copy and raw traces are kept (password mode). Its
# rows stay. 0 keeps the files forever.
RUN_ARTIFACT_RETENTION_DAYS=30
# Input plus output tokens one Run may use before no new attempt starts.
RUN_TOKEN_BUDGET=2000000

# One disposable container per execution for Claude's tools.
# scripts/start-local-poc.sh starts a Docker/Colima/Podman Runtime.
CONTAINER_ENGINE=docker
# Build it with `npm run build:claude-runtime`.
CONTAINER_RUNTIME_IMAGE=agentguard-claude-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates curl git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# PostgreSQL (docker compose). The port is bound to loopback only; set a real
# password anywhere other than your laptop. Avoid URL-special characters in it.
# POSTGRES_PASSWORD=launchpad
# POSTGRES_PORT=5433
# The server migrates and uses DATABASE_URL when it is set (compose overrides it
# for the launchpad service). Export these in your shell for
# `npm run db:migrate -w @launchpad/server` or the persistence tests.
DATABASE_URL=postgres://launchpad:launchpad@127.0.0.1:5433/launchpad
# TEST_DATABASE_URL=postgres://launchpad:launchpad@127.0.0.1:5433/launchpad
