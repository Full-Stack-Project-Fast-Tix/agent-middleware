{
  "name": "@launchpad/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "dev:demo": "tsx watch --conditions=development src/index.ts --runs-demo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:fuzz": "vitest run tests/orchestrator/fuzz.test.ts",
    "benchmark:multi-agent": "tsx --conditions=development ../../benchmark/run-multi-agent-live.ts",
    "verify:claude-runtime": "tsx --conditions=development scripts/verify-claude-runtime.ts",
    "measure:orchestration": "tsx --conditions=development scripts/measure-orchestration.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx --conditions=development src/db/migrate-cli.ts",
    "db:admin": "tsx --conditions=development src/db/admin-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@launchpad/shared": "1.0.0",
    "fastify": "^5.6.2",
    "pg": "^8.23.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
